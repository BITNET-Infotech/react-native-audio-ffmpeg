{
  "name": "@bitnet-infotech/react-native-audio-ffmpeg",
  "version": "1.0.0",
  "description": "Universal audio processing for React Native — merge, convert, trim any audio format. New Architecture Turbo Module.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "AudioFFmpeg.podspec",
    "react-native.config.js",
    "USAGE.md",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build":      "bob build",
    "typecheck":  "tsc --noEmit",
    "lint":       "eslint src --ext .ts,.tsx --fix",
    "test":       "jest",
    "prepare":    "bob build",
    "bootstrap":  "yarn install && yarn --cwd example install && cd example/ios && pod install"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "ffmpeg",
    "audio",
    "mp3",
    "aac",
    "flac",
    "opus",
    "wav",
    "merge",
    "convert",
    "trim",
    "turbo-module",
    "new-architecture",
    "jsi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BITNET-Infotech/react-native-audio-ffmpeg.git"
  },
  "author": "BITNET Infotech",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/BITNET-Infotech/react-native-audio-ffmpeg/issues"
  },
  "homepage": "https://github.com/BITNET-Infotech/react-native-audio-ffmpeg#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.85.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.85.3",
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/react": "^19.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.30.0",
    "typescript": "^5.7.0"
  },
  "codegenConfig": {
    "name": "RNAudioFFmpegSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.audioffmpeg"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["commonjs", { "esm": true }],
      ["module",   { "esm": true }],
      "typescript"
    ]
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  }
}
